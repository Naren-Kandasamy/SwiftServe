{
  "rules": {
    "venues": {
      "$venueId": {
        "alerts": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$alertId": {
            ".write": "auth != null && (auth.token.firebase.sign_in_provider != 'anonymous' || !data.exists())"
          }
        },
        "incidents": {
          // Any authenticated user (including guests) can READ incidents to see their AI response
          ".read": "auth != null",
          // Only staff (non-anonymous) can WRITE incidents
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'"
        },
        "roomTokens": {
          // Guests need to read/write their own room token for check-in
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "messages": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
          "$incidentId": {
            "$messageId": {
              ".write": "auth != null && (auth.token.firebase.sign_in_provider != 'anonymous' || !data.exists())"
            }
          }
        },
        "internal_messages": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'"
        },
        "config": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'"
        }
      }
    }
  }
}
